# ─────────────────────────────────────────────────────────────
# MedSchedule AI — backend environment (copy to backend/.env)
# Never commit a real .env file.
# ─────────────────────────────────────────────────────────────

# Google Gemini (structured extraction of unstructured syllabi).
# Optional: structured files are handled by the built-in rule-based parser without a key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Read by config; reserved for a hosted embedding model (current embeddings are computed locally).
GEMINI_EMBEDDING_MODEL=text-embedding-004

# PostgreSQL + pgvector (Supabase). Optional: without a reachable database the
# API runs fully in-memory and uses in-process cosine similarity.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
SUPABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_KEY=

# Comma-separated list of allowed browser origins (use * to allow all).
CORS_ORIGINS=http://localhost:3000,https://medschedule-ai.vercel.app

# Keeps numpy/OR-Tools from oversubscribing CPU threads on small instances.
OPENBLAS_NUM_THREADS=1
